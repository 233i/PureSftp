<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:colorPicker="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
        xmlns:models="using:PureSFTP.Models"
        xmlns:vm="using:PureSFTP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="Root"
        d:DesignWidth="1220"
        d:DesignHeight="780"
        x:Class="PureSFTP.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/puresftp.ico"
        Title="PureSftp"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.commandBar">
            <Setter Property="Background" Value="{DynamicResource CommandBarBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.browserSurface">
            <Setter Property="Background" Value="{DynamicResource BrowserSurfaceBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.heroLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C8D7EA" />
        </Style>

        <Style Selector="TextBlock.heroTitle">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <Style Selector="TextBlock.heroCaption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D5E2F0" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="TextBlock.subtle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style Selector="TextBlock.brandTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource PathBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.secondary:disabled">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ToggleButton.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
        </Style>

        <Style Selector="ToggleButton.tab:checked">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="Button.nav:disabled">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBox#PART_HexTextBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ListBox.connections">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style Selector="ListBox.connections ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBox.connections ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBrush}" />
        </Style>

        <Style Selector="ListBox.connections ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBrush}" />
        </Style>

        <Style Selector="ListBox.remoteItems">
            <Setter Property="Background" Value="{DynamicResource BrowserSurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <Style Selector="ListBox.remoteItems ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBox.remoteItems ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource FileRowHoverBrush}" />
        </Style>

        <Style Selector="ListBox.remoteItems ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource FileRowSelectedBrush}" />
        </Style>

        <Style Selector="MenuItem.fileMenuItem">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="MenuItem.fileMenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource HeaderBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style Selector="MenuItem.fileMenuItem:disabled">
            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
        </Style>

        <Style Selector="Button.toastAction">
            <Setter Property="Background" Value="{DynamicResource ToastButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToastBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Button.toastAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource ToastButtonHoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        </Style>

        <Style Selector="Button.headerButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.headerButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

    </Window.Styles>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{Binding Texts.ConnectionMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.NewConnectionButton}"
                                        Command="{Binding ShowNewConnectionCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding Texts.DisconnectButton}"
                                        Command="{Binding DisconnectCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="{Binding Texts.FileMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.UploadButton}"
                                        Command="{Binding UploadCommand}" />
                        <NativeMenuItem Header="{Binding Texts.UploadFolderButton}"
                                        Command="{Binding UploadFolderCommand}" />
                        <NativeMenuItem Header="{Binding Texts.DownloadButton}"
                                        Command="{Binding DownloadCommand}" />
                        <NativeMenuItem Header="{Binding Texts.RenameButton}"
                                        Command="{Binding RenameSelectedCommand}" />
                        <NativeMenuItem Header="{Binding Texts.ChmodButton}"
                                        Command="{Binding ChangePermissionsCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding Texts.CreateFolderButton}"
                                        Command="{Binding ShowCreateFolderDialogCommand}" />
                        <NativeMenuItem Header="{Binding Texts.DeleteButton}"
                                        Command="{Binding DeleteSelectedCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="{Binding Texts.BrowserMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.OpenButton}"
                                        Command="{Binding OpenSelectedCommand}" />
                        <NativeMenuItem Header="{Binding Texts.UpButton}"
                                        Command="{Binding GoToParentCommand}" />
                        <NativeMenuItem Header="{Binding Texts.RefreshButton}"
                                        Command="{Binding RefreshCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="{Binding Texts.ViewMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.WorkspaceNavButton}"
                                        Command="{Binding ShowWorkspacePageCommand}" />
                        <NativeMenuItem Header="{Binding Texts.SettingsNavButton}"
                                        Command="{Binding ShowSettingsPageCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="16"
          RowDefinitions="Auto,*"
          RowSpacing="12">
        <Border Classes="commandBar">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Classes="brandTitle"
                               VerticalAlignment="Center"
                               Text="PureSftp" />
                </StackPanel>

                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource PathBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="22"
                        Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton Classes="tab"
                                      Content="{Binding Texts.WorkspaceNavButton}"
                                      IsChecked="{Binding IsWorkspacePageSelected, Mode=TwoWay}" />
                        <ToggleButton Classes="tab"
                                      Content="{Binding Texts.SettingsNavButton}"
                                      IsChecked="{Binding IsSettingsPageSelected, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource PathBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="10,7">
                    <Grid ColumnDefinitions="Auto,Auto"
                          ColumnSpacing="8">
                        <Grid Width="10"
                              Height="10"
                              VerticalAlignment="Center">
                            <Ellipse Fill="{DynamicResource StatusOnlineBrush}"
                                     IsVisible="{Binding IsConnectionBadgeOnline}" />
                            <Ellipse Fill="{DynamicResource StatusWorkingBrush}"
                                     IsVisible="{Binding IsConnectionBadgeWorking}" />
                            <Ellipse Fill="{DynamicResource StatusOfflineBrush}"
                                     IsVisible="{Binding IsConnectionBadgeOffline}" />
                        </Grid>
                        <StackPanel Grid.Column="1"
                                    Spacing="1"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="label"
                                       FontSize="11"
                                       Text="{Binding ConnectionStateText}" />
                            <TextBlock Classes="subtle"
                                       FontSize="11"
                                       Text="{Binding ActiveConnectionTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="180" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding IsWorkspacePageSelected}"
                  ColumnDefinitions="300,*"
                  ColumnSpacing="14">
                <Border Grid.Column="0" Classes="sidebar">
                    <Grid RowDefinitions="Auto,*">
                        <Border Padding="16,14,12,10">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10"
                                  MinHeight="34"
                                  VerticalAlignment="Center">
                                <TextBlock Classes="label"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Text="{Binding Texts.ConnectionsTitle}" />
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        Padding="12,7"
                                        VerticalAlignment="Center"
                                        Command="{Binding ShowNewConnectionCommand}"
                                        Content="{Binding Texts.NewConnectionButton}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                IsVisible="{Binding HasNoSavedConnections}"
                                Margin="14"
                                Background="{DynamicResource SidebarItemHoverBrush}"
                                CornerRadius="12"
                                Padding="14,13"
                                VerticalAlignment="Top">
                            <TextBlock Classes="subtle"
                                       Text="{Binding Texts.NoConnectionsHint}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <ListBox Grid.Row="1"
                                 Name="SavedConnectionsListBox"
                                 Classes="connections"
                                 DoubleTapped="OnSavedConnectionsDoubleTapped"
                                 PointerPressed="OnSavedConnectionsPointerPressed"
                                 ItemsSource="{Binding SavedConnections}"
                                 IsVisible="{Binding HasSavedConnections}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.EditConnectionButton}"
                                              Click="OnEditSavedConnectionMenuClick" />
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.DeleteConnectionButton}"
                                              Click="OnDeleteSavedConnectionMenuClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SavedConnectionViewModel">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10"
                                          MinHeight="40"
                                          Background="Transparent"
                                          DoubleTapped="OnSavedConnectionItemDoubleTapped"
                                          PointerPressed="OnSavedConnectionItemPointerPressed"
                                          Margin="12,0">
                                        <TextBlock Classes="value"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Ellipse Grid.Column="1"
                                                 Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource StatusOnlineBrush}"
                                                 IsVisible="{Binding IsActive}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Classes="browserSurface"
                        Padding="0">
                    <Grid RowDefinitions="Auto,Auto,Auto,*">
                        <Border Padding="12"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,Auto,*,220,Auto,Auto"
                                  ColumnSpacing="8">
                                <Button Classes="secondary"
                                        Command="{Binding GoToParentCommand}"
                                        Content="{Binding Texts.UpButton}" />
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Command="{Binding RefreshCommand}"
                                        Content="{Binding Texts.RefreshButton}" />
                                <Border Grid.Column="2"
                                        Background="{DynamicResource PathBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,8">
                                    <TextBlock Classes="value"
                                               FontSize="13"
                                               Text="{Binding Browser.CurrentPath}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBox Grid.Column="3"
                                         Text="{Binding Browser.FilterText, Mode=TwoWay}"
                                         PlaceholderText="{Binding Texts.FilterPlaceholder}" />
                                <CheckBox Grid.Column="4"
                                          VerticalAlignment="Center"
                                          Content="{Binding Texts.ShowHiddenItemsLabel}"
                                          IsChecked="{Binding Browser.ShowHiddenItems, Mode=TwoWay}" />
                                <TextBlock Grid.Column="5"
                                           VerticalAlignment="Center"
                                           Classes="subtle"
                                           Text="{Binding SelectionSummary}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource HeaderBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,1"
                                Padding="14,8">
                            <Grid ColumnDefinitions="42,*,92,74,74,106,150" ColumnSpacing="12">
                                <TextBlock Classes="label" Text="" />
                                <Button Grid.Column="1"
                                        Classes="headerButton"
                                        Command="{Binding SortByNameCommand}"
                                        Content="{Binding SortNameHeader}" />
                                <Button Grid.Column="2"
                                        Classes="headerButton"
                                        Command="{Binding SortBySizeCommand}"
                                        Content="{Binding SortSizeHeader}" />
                                <Button Grid.Column="3"
                                        Classes="headerButton"
                                        Command="{Binding SortByModifiedAtCommand}"
                                        Content="{Binding SortModifiedHeader}" />
                                <TextBlock Grid.Column="4"
                                           Classes="label"
                                           Text="{Binding Texts.OwnerHeader}" />
                                <TextBlock Grid.Column="5"
                                           Classes="label"
                                           Text="{Binding Texts.GroupHeader}" />
                                <TextBlock Grid.Column="6"
                                           Classes="label"
                                           Text="{Binding Texts.PermissionsHeader}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3">
                            <ListBox Name="RemoteItemsListBox"
                                     Classes="remoteItems"
                                     DoubleTapped="OnRemoteItemsDoubleTapped"
                                     SelectionMode="Multiple"
                                     SelectionChanged="OnRemoteItemsSelectionChanged"
                                     DragDrop.AllowDrop="True"
                                     DragDrop.DragOver="OnRemoteItemsDragOver"
                                     DragDrop.Drop="OnRemoteItemsDrop"
                                     ItemsSource="{Binding Browser.Items}"
                                     SelectedItem="{Binding Browser.SelectedItem, Mode=TwoWay}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.UploadButton}"
                                                  Command="{Binding UploadCommand}" />
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.UploadFolderButton}"
                                                  Command="{Binding UploadFolderCommand}" />
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.DownloadButton}"
                                                  Command="{Binding DownloadCommand}" />
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.RenameButton}"
                                                  Command="{Binding RenameSelectedCommand}" />
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.ChmodButton}"
                                                  Command="{Binding ChangePermissionsCommand}" />
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.DeleteButton}"
                                                  Command="{Binding DeleteSelectedCommand}" />
                                        <Separator />
                                        <MenuItem Classes="fileMenuItem"
                                                  Header="{Binding Texts.CreateFolderButton}"
                                                  Command="{Binding ShowCreateFolderDialogCommand}" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RemoteItem">
                                        <Border BorderBrush="{DynamicResource RowBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="10,7"
                                                MinHeight="42">
                                            <Grid ColumnDefinitions="42,*,92,74,74,106,150" ColumnSpacing="12">
                                                <Grid Width="30"
                                                      Height="26"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center">
                                                    <Grid IsVisible="{Binding ShowFolderIcon}">
                                                        <Border Width="26"
                                                                Height="17"
                                                                CornerRadius="4"
                                                                Background="#F6C15B"
                                                                VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center" />
                                                        <Border Width="15"
                                                                Height="7"
                                                                CornerRadius="3,3,0,0"
                                                                Background="#E9A738"
                                                                Margin="3,2,0,0"
                                                                VerticalAlignment="Top"
                                                                HorizontalAlignment="Left" />
                                                        <Border Width="26"
                                                                Height="13"
                                                                CornerRadius="4"
                                                                Background="#FFD66E"
                                                                VerticalAlignment="Bottom"
                                                                HorizontalAlignment="Center" />
                                                    </Grid>

                                                    <Grid IsVisible="{Binding ShowFileIcon}">
                                                        <Border Width="21"
                                                                Height="25"
                                                                CornerRadius="4"
                                                                Background="#EAF2FF"
                                                                BorderBrush="#9BBBE8"
                                                                BorderThickness="1"
                                                                HorizontalAlignment="Center" />
                                                        <Path Data="M 16 1 L 21 6 L 16 6 Z"
                                                              Fill="#CFE0F8"
                                                              HorizontalAlignment="Center" />
                                                        <Border Width="11"
                                                                Height="2"
                                                                Background="#5D8DD6"
                                                                CornerRadius="1"
                                                                Margin="0,10,0,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Top" />
                                                        <Border Width="11"
                                                                Height="2"
                                                                Background="#A7C3EA"
                                                                CornerRadius="1"
                                                                Margin="0,15,0,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Top" />
                                                    </Grid>

                                                    <Grid IsVisible="{Binding ShowParentIcon}">
                                                        <Border Width="24"
                                                                Height="24"
                                                                CornerRadius="12"
                                                                Background="{DynamicResource PanelBackgroundBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1" />
                                                        <Path Data="M 15 7 L 9 13 L 15 19"
                                                              Stroke="{DynamicResource TextMutedBrush}"
                                                              StrokeThickness="2"
                                                              StrokeLineCap="Round"
                                                              StrokeJoin="Round" />
                                                    </Grid>
                                                </Grid>
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           Classes="value"
                                                           Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           VerticalAlignment="Center"
                                                           Classes="subtle"
                                                           Text="{Binding SizeText}" />
                                                <TextBlock Grid.Column="3"
                                                           VerticalAlignment="Center"
                                                           Classes="subtle"
                                                           Text="{Binding ModifiedText}" />
                                                <TextBlock Grid.Column="4"
                                                           VerticalAlignment="Center"
                                                           Classes="subtle"
                                                           Text="{Binding OwnerText}" />
                                                <TextBlock Grid.Column="5"
                                                           VerticalAlignment="Center"
                                                           Classes="subtle"
                                                           Text="{Binding GroupText}" />
                                                <TextBlock Grid.Column="6"
                                                           VerticalAlignment="Center"
                                                           Classes="subtle"
                                                           FontFamily="Consolas, Menlo, monospace"
                                                           Text="{Binding PermissionsText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border IsVisible="{Binding IsBrowserPlaceholderVisible}"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="380"
                                    Padding="24">
                                <StackPanel Spacing="12"
                                            HorizontalAlignment="Center">
                                    <Border Width="48"
                                            Height="48"
                                            CornerRadius="18"
                                            Background="{DynamicResource PathBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Center">
                                        <Path Data="M 16 17 L 24 11 L 32 17 M 24 12 L 24 36 M 16 26 L 32 26"
                                              Stroke="{DynamicResource TextMutedBrush}"
                                              StrokeThickness="2.2"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Classes="subtle"
                                               Text="{Binding BrowserPlaceholderText}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsSettingsPageSelected}">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    </Transitions>
                </Grid.Transitions>
                <ScrollViewer HorizontalAlignment="Center"
                              Width="900"
                              VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="16">
                        <Grid.Resources>
                            <PlacementMode x:Key="ColorPickerFlyoutPlacement">Bottom</PlacementMode>
                        </Grid.Resources>
                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="sectionTitle" Text="{Binding Texts.SettingsTitle}" />
                                <TextBlock Classes="subtle"
                                           Text="{Binding Texts.SettingsDescription}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="16">
                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <TextBlock Classes="sectionTitle" Text="{Binding Texts.LanguageTitle}" />
                                <TextBlock Classes="subtle"
                                           Text="{Binding Texts.LanguageDescription}"
                                           TextWrapping="Wrap" />

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="{Binding Texts.LanguageLabel}" />
                                    <ComboBox ItemsSource="{Binding Settings.LanguageOptions}"
                                              SelectedItem="{Binding Settings.SelectedLanguageOption, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="{Binding Texts.LanguagePreviewLabel}" />
                                        <TextBlock Classes="value" Text="{Binding Settings.SelectedLanguageDisplayName}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="14">
                                <TextBlock Classes="sectionTitle" Text="{Binding Texts.ThemeTitle}" />
                                <TextBlock Classes="subtle"
                                           Text="{Binding Texts.ThemeDescription}"
                                           TextWrapping="Wrap" />

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="{Binding Texts.ThemeLabel}" />
                                    <ComboBox ItemsSource="{Binding Settings.ThemeOptions}"
                                              SelectedItem="{Binding Settings.SelectedThemeOption, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ThemeOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Spacing="8"
                                            IsVisible="{Binding Settings.IsCustomThemeSelected}">
                                    <StackPanel Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="label" Text="{Binding Texts.CustomGradientStartLabel}" />
                                            <colorPicker:ColorPicker Color="{Binding Settings.CustomGradientStartColorValue, Mode=TwoWay}"
                                                                     Width="120"
                                                                     Height="34"
                                                                     ColorSpectrumShape="Ring"
                                                                     IsAlphaEnabled="False"
                                                                     IsAlphaVisible="False">
                                                <colorPicker:ColorPicker.Resources>
                                                    <x:Double x:Key="ColorViewComponentLabelWidth">72</x:Double>
                                                    <x:Double x:Key="ColorViewComponentTextInputWidth">112</x:Double>
                                                </colorPicker:ColorPicker.Resources>
                                            </colorPicker:ColorPicker>
                                            <TextBlock Classes="subtle"
                                                       Text="{Binding Settings.CustomGradientStartColor}" />
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Classes="label" Text="{Binding Texts.CustomGradientEndLabel}" />
                                            <colorPicker:ColorPicker Color="{Binding Settings.CustomGradientEndColorValue, Mode=TwoWay}"
                                                                     Width="120"
                                                                     Height="34"
                                                                     ColorSpectrumShape="Ring"
                                                                     IsAlphaEnabled="False"
                                                                     IsAlphaVisible="False">
                                                <colorPicker:ColorPicker.Resources>
                                                    <x:Double x:Key="ColorViewComponentLabelWidth">72</x:Double>
                                                    <x:Double x:Key="ColorViewComponentTextInputWidth">112</x:Double>
                                                </colorPicker:ColorPicker.Resources>
                                            </colorPicker:ColorPicker>
                                            <TextBlock Classes="subtle"
                                                       Text="{Binding Settings.CustomGradientEndColor}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Height="42"
                                            Background="{DynamicResource AppBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12" />

                                    <TextBlock Classes="subtle"
                                               Text="{Binding Texts.CustomGradientHint}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="{Binding Texts.ThemePreviewLabel}" />
                                        <TextBlock Classes="value" Text="{Binding Settings.SelectedThemeDisplayName}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Classes="card">
                            <StackPanel Spacing="14">
                                <TextBlock Classes="sectionTitle" Text="{Binding Texts.AppInfoTitle}" />
                                <TextBlock Classes="subtle"
                                           Text="{Binding Texts.AppInfoDescription}"
                                           TextWrapping="Wrap" />
                                <Border Background="{DynamicResource PanelBackgroundBrush}"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="label" Text="PureSftp" />
                                        <TextBlock Classes="value" Text="{Binding ConnectionStateText}" />
                                        <TextBlock Classes="subtle"
                                                   Text="{Binding ConnectionSummary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <ItemsControl HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,12,0,0"
                          ItemsSource="{Binding Toasts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToastMessageViewModel">
                        <Border Background="{DynamicResource ToastBackgroundBrush}"
                                Width="300"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="{Binding ToastMargin}"
                                Opacity="{Binding ToastOpacity}">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin" Duration="0:0:0.24" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Foreground="{DynamicResource TextOnAccentBrush}"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10"
                                      IsVisible="{Binding IsProgressVisible}">
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="6"
                                                 Value="{Binding Progress}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextOnAccentBrush}"
                                               Text="{Binding ProgressText}" />
                                    <Button Grid.Column="2"
                                            Classes="toastAction"
                                            Command="{Binding CancelTransferCommand}"
                                            Content="{Binding CancelText}"
                                            IsVisible="{Binding IsCancelable}" />
                                </Grid>
                                <Button Grid.Row="2"
                                        Classes="toastAction"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CancelTransferCommand}"
                                        Content="{Binding CancelText}"
                                        IsVisible="{Binding IsActionVisible}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
