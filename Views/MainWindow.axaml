<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:PureSFTP.Models"
        xmlns:vm="using:PureSFTP.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="Root"
        d:DesignWidth="1220"
        d:DesignHeight="780"
        x:Class="PureSFTP.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/puresftp.ico"
        Title="PureSftp"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#EEF3F8">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FCFDFE" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="22" />
            <Setter Property="BorderBrush" Value="#D7E1EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#C9D6E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5E7388" />
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="TextBlock.heroLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#C8D7EA" />
        </Style>

        <Style Selector="TextBlock.heroTitle">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="TextBlock.heroCaption">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#D5E2F0" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="TextBlock.subtle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#6A7F93" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#102236" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#102236" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#18314A" />
            <Setter Property="BorderBrush" Value="#18314A" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.primary:pressed">
            <Setter Property="Background" Value="#0B1826" />
            <Setter Property="BorderBrush" Value="#0B1826" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="#D7E1EB" />
            <Setter Property="BorderBrush" Value="#D7E1EB" />
            <Setter Property="Foreground" Value="#71869A" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#102236" />
            <Setter Property="BorderBrush" Value="#CAD6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="BorderBrush" Value="#B8C8D8" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="Button.secondary:pressed">
            <Setter Property="Background" Value="#DCE6F0" />
            <Setter Property="BorderBrush" Value="#AEBFD0" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="Button.secondary:disabled">
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="BorderBrush" Value="#DFE7EF" />
            <Setter Property="Foreground" Value="#8A9AAC" />
        </Style>

        <Style Selector="Button.nav">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#102236" />
            <Setter Property="BorderBrush" Value="#CAD6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ToggleButton.tab">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#102236" />
            <Setter Property="BorderBrush" Value="#D7E1EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style Selector="ToggleButton.tab:checked">
            <Setter Property="Background" Value="#102236" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#102236" />
        </Style>

        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="BorderBrush" Value="#B8C8D8" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="Button.nav:pressed">
            <Setter Property="Background" Value="#DCE6F0" />
            <Setter Property="BorderBrush" Value="#AEBFD0" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="Button.nav:disabled">
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="BorderBrush" Value="#DFE7EF" />
            <Setter Property="Foreground" Value="#8A9AAC" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#F6F9FC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#D7E1EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#F6F9FC" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="#D7E1EB" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ListBox.connections">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
        </Style>

        <Style Selector="ListBox.connections ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="ListBox.connections ListBoxItem:pointerover">
            <Setter Property="Background" Value="#EEF4FA" />
        </Style>

        <Style Selector="ListBox.connections ListBoxItem:selected">
            <Setter Property="Background" Value="#DCE8F3" />
        </Style>

        <Style Selector="MenuItem.fileMenuItem">
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Background" Value="#FCFDFE" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="MenuItem.fileMenuItem:pointerover">
            <Setter Property="Background" Value="#F4F7FA" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="MenuItem.fileMenuItem:disabled">
            <Setter Property="Foreground" Value="#8A9AAC" />
        </Style>

        <Style Selector="Button.toastAction">
            <Setter Property="Background" Value="#203953" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#31506E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style Selector="Button.toastAction:pointerover">
            <Setter Property="Background" Value="#294866" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="Button.headerButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#5E7388" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style Selector="Button.headerButton:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>
    </Window.Styles>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{Binding Texts.ConnectionMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.NewConnectionButton}"
                                        Command="{Binding ShowNewConnectionCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding Texts.DisconnectButton}"
                                        Command="{Binding DisconnectCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="{Binding Texts.FileMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.UploadButton}"
                                        Command="{Binding UploadCommand}" />
                        <NativeMenuItem Header="{Binding Texts.UploadFolderButton}"
                                        Command="{Binding UploadFolderCommand}" />
                        <NativeMenuItem Header="{Binding Texts.DownloadButton}"
                                        Command="{Binding DownloadCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{Binding Texts.CreateFolderButton}"
                                        Command="{Binding ShowCreateFolderDialogCommand}" />
                        <NativeMenuItem Header="{Binding Texts.DeleteButton}"
                                        Command="{Binding DeleteSelectedCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="{Binding Texts.BrowserMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.OpenButton}"
                                        Command="{Binding OpenSelectedCommand}" />
                        <NativeMenuItem Header="{Binding Texts.UpButton}"
                                        Command="{Binding GoToParentCommand}" />
                        <NativeMenuItem Header="{Binding Texts.RefreshButton}"
                                        Command="{Binding RefreshCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>

            <NativeMenuItem Header="{Binding Texts.ViewMenu}">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{Binding Texts.WorkspaceNavButton}"
                                        Command="{Binding ShowWorkspacePageCommand}" />
                        <NativeMenuItem Header="{Binding Texts.SettingsNavButton}"
                                        Command="{Binding ShowSettingsPageCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="20"
          RowDefinitions="Auto,*"
          RowSpacing="16">
        <Border Classes="card" Padding="12">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                  ColumnSpacing="12">
                <ToggleButton Classes="tab"
                              Content="{Binding Texts.WorkspaceNavButton}"
                              IsChecked="{Binding IsWorkspacePageSelected, Mode=TwoWay}" />
                <ToggleButton Grid.Column="1"
                              Classes="tab"
                              Content="{Binding Texts.SettingsNavButton}"
                              IsChecked="{Binding IsSettingsPageSelected, Mode=TwoWay}" />
                <TextBlock Grid.Column="3"
                           VerticalAlignment="Center"
                           Classes="label"
                           Text="{Binding ConnectionStateText}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid IsVisible="{Binding IsWorkspacePageSelected}"
                  ColumnDefinitions="340,*"
                  ColumnSpacing="20">
                <Border Grid.Column="0" Classes="sidebar">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border Background="#FCFDFE"
                                CornerRadius="10,10,0,0"
                                Padding="16,14"
                                BorderBrush="#D7E1EB"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="10"
                                  MinHeight="40"
                                  VerticalAlignment="Center">
                                <TextBlock Classes="sectionTitle"
                                           FontSize="17"
                                           VerticalAlignment="Center"
                                           Text="{Binding Texts.ConnectionsTitle}" />
                                <Button Grid.Column="1"
                                        Classes="primary"
                                        VerticalAlignment="Center"
                                        Command="{Binding ShowNewConnectionCommand}"
                                        Content="{Binding Texts.NewConnectionButton}" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Height="1"
                                Background="#E6EDF4" />

                        <Border Grid.Row="2"
                                IsVisible="{Binding HasNoSavedConnections}"
                                Margin="14"
                                Background="#EEF4FA"
                                CornerRadius="8"
                                Padding="14">
                            <TextBlock Classes="subtle"
                                       Text="{Binding Texts.NoConnectionsHint}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <ListBox Grid.Row="2"
                                 Name="SavedConnectionsListBox"
                                 Classes="connections"
                                 DoubleTapped="OnSavedConnectionsDoubleTapped"
                                 PointerPressed="OnSavedConnectionsPointerPressed"
                                 ItemsSource="{Binding SavedConnections}"
                                 IsVisible="{Binding HasSavedConnections}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.EditConnectionButton}"
                                              Click="OnEditSavedConnectionMenuClick" />
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.DeleteConnectionButton}"
                                              Click="OnDeleteSavedConnectionMenuClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SavedConnectionViewModel">
                                    <Grid ColumnDefinitions="16,*"
                                          ColumnSpacing="10"
                                          MinHeight="38"
                                          Background="Transparent"
                                          Margin="10,0">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="#18A058"
                                                 IsVisible="{Binding IsActive}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="value"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Classes="card"
                        Padding="0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <Border Background="#FCFDFE"
                                Padding="14,12">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                                  ColumnSpacing="8">
                                <Button Classes="secondary"
                                        Command="{Binding GoToParentCommand}"
                                        Content="{Binding Texts.UpButton}" />
                                <Button Grid.Column="1"
                                        Classes="secondary"
                                        Command="{Binding OpenSelectedCommand}"
                                        Content="{Binding Texts.OpenButton}" />
                                <Button Grid.Column="2"
                                        Classes="secondary"
                                        Command="{Binding RefreshCommand}"
                                        Content="{Binding Texts.RefreshButton}" />
                                <Border Grid.Column="3"
                                        Background="#F6F9FC"
                                        BorderBrush="#D7E1EB"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,8">
                                    <TextBlock Classes="value"
                                               Text="{Binding Browser.CurrentPath}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                                <TextBlock Grid.Column="4"
                                           VerticalAlignment="Center"
                                           Classes="subtle"
                                           Text="{Binding SelectionSummary}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Background="#F4F7FA"
                                BorderBrush="#D7E1EB"
                                BorderThickness="0,1,0,1"
                                Padding="12,8">
                            <Grid ColumnDefinitions="48,*,72,120,160" ColumnSpacing="12">
                                <TextBlock Classes="label" Text="" />
                                <Button Grid.Column="1"
                                        Classes="headerButton"
                                        Command="{Binding SortByNameCommand}"
                                        Content="{Binding SortNameHeader}" />
                                <TextBlock Grid.Column="2" Classes="label" Text="" />
                                <Button Grid.Column="3"
                                        Classes="headerButton"
                                        Command="{Binding SortBySizeCommand}"
                                        Content="{Binding SortSizeHeader}" />
                                <Button Grid.Column="4"
                                        Classes="headerButton"
                                        Command="{Binding SortByModifiedAtCommand}"
                                        Content="{Binding SortModifiedHeader}" />
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="2"
                                 Name="RemoteItemsListBox"
                                 Background="#FCFDFE"
                                 BorderThickness="0"
                                 DoubleTapped="OnRemoteItemsDoubleTapped"
                                 SelectionMode="Multiple"
                                 SelectionChanged="OnRemoteItemsSelectionChanged"
                                 DragDrop.AllowDrop="True"
                                 DragDrop.DragOver="OnRemoteItemsDragOver"
                                 DragDrop.Drop="OnRemoteItemsDrop"
                                 ItemsSource="{Binding Browser.Items}"
                                 SelectedItem="{Binding Browser.SelectedItem, Mode=TwoWay}">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.UploadButton}"
                                              Command="{Binding UploadCommand}" />
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.UploadFolderButton}"
                                              Command="{Binding UploadFolderCommand}" />
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.DownloadButton}"
                                              Command="{Binding DownloadCommand}" />
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.DeleteButton}"
                                              Command="{Binding DeleteSelectedCommand}" />
                                    <Separator />
                                    <MenuItem Classes="fileMenuItem"
                                              Header="{Binding Texts.CreateFolderButton}"
                                              Command="{Binding ShowCreateFolderDialogCommand}" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:RemoteItem">
                                    <Border BorderBrush="#E4EAF0"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,7"
                                            MinHeight="36">
                                        <Grid ColumnDefinitions="48,*,72,120,160" ColumnSpacing="12">
                                            <Grid Width="30"
                                                  Height="26"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center">
                                                <Grid IsVisible="{Binding ShowFolderIcon}">
                                                    <Border Width="26"
                                                            Height="17"
                                                            CornerRadius="4"
                                                            Background="#F6C15B"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center" />
                                                    <Border Width="15"
                                                            Height="7"
                                                            CornerRadius="3,3,0,0"
                                                            Background="#E9A738"
                                                            Margin="3,2,0,0"
                                                            VerticalAlignment="Top"
                                                            HorizontalAlignment="Left" />
                                                    <Border Width="26"
                                                            Height="13"
                                                            CornerRadius="4"
                                                            Background="#FFD66E"
                                                            VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Center" />
                                                </Grid>

                                                <Grid IsVisible="{Binding ShowFileIcon}">
                                                    <Border Width="21"
                                                            Height="25"
                                                            CornerRadius="4"
                                                            Background="#EAF2FF"
                                                            BorderBrush="#9BBBE8"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Center" />
                                                    <Path Data="M 16 1 L 21 6 L 16 6 Z"
                                                          Fill="#CFE0F8"
                                                          HorizontalAlignment="Center" />
                                                    <Border Width="11"
                                                            Height="2"
                                                            Background="#5D8DD6"
                                                            CornerRadius="1"
                                                            Margin="0,10,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top" />
                                                    <Border Width="11"
                                                            Height="2"
                                                            Background="#A7C3EA"
                                                            CornerRadius="1"
                                                            Margin="0,15,0,0"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Top" />
                                                </Grid>

                                                <Grid IsVisible="{Binding ShowParentIcon}">
                                                    <Border Width="24"
                                                            Height="24"
                                                            CornerRadius="12"
                                                            Background="#EEF2F6"
                                                            BorderBrush="#D7E1EB"
                                                            BorderThickness="1" />
                                                    <Path Data="M 15 7 L 9 13 L 15 19"
                                                          Stroke="#6A7F93"
                                                          StrokeThickness="2"
                                                          StrokeLineCap="Round"
                                                          StrokeJoin="Round" />
                                                </Grid>
                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       VerticalAlignment="Center"
                                                       Classes="value"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Ellipse Grid.Column="2"
                                                     Width="8"
                                                     Height="8"
                                                     Fill="{Binding TypeDotColor}"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left" />
                                            <TextBlock Grid.Column="3"
                                                       VerticalAlignment="Center"
                                                       Classes="subtle"
                                                       Text="{Binding SizeText}" />
                                            <TextBlock Grid.Column="4"
                                                       VerticalAlignment="Center"
                                                       Classes="subtle"
                                                       Text="{Binding ModifiedText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Grid IsVisible="{Binding IsSettingsPageSelected}">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    </Transitions>
                </Grid.Transitions>
                <Grid HorizontalAlignment="Center"
                      Width="760"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="16">
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="sectionTitle" Text="{Binding Texts.SettingsTitle}" />
                            <TextBlock Classes="subtle"
                                       Text="{Binding Texts.SettingsDescription}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="16">
                        <Border Classes="card">
                            <StackPanel Spacing="14">
                                <TextBlock Classes="sectionTitle" Text="{Binding Texts.LanguageTitle}" />
                                <TextBlock Classes="subtle"
                                           Text="{Binding Texts.LanguageDescription}"
                                           TextWrapping="Wrap" />

                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="{Binding Texts.LanguageLabel}" />
                                    <ComboBox ItemsSource="{Binding Settings.LanguageOptions}"
                                              SelectedItem="{Binding Settings.SelectedLanguageOption, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <Border Background="#F4F8FB"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="{Binding Texts.LanguagePreviewLabel}" />
                                        <TextBlock Classes="value" Text="{Binding Settings.SelectedLanguageDisplayName}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Classes="card">
                            <StackPanel Spacing="14">
                                <TextBlock Classes="sectionTitle" Text="{Binding Texts.AppInfoTitle}" />
                                <TextBlock Classes="subtle"
                                           Text="{Binding Texts.AppInfoDescription}"
                                           TextWrapping="Wrap" />
                                <Border Background="#F4F8FB"
                                        CornerRadius="16"
                                        Padding="14">
                                    <StackPanel Spacing="8">
                                        <TextBlock Classes="label" Text="PureSftp" />
                                        <TextBlock Classes="value" Text="{Binding ConnectionStateText}" />
                                        <TextBlock Classes="subtle"
                                                   Text="{Binding ConnectionSummary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <ItemsControl HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="0,12,0,0"
                          ItemsSource="{Binding Toasts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ToastMessageViewModel">
                        <Border Background="#102236"
                                Width="300"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="{Binding ToastMargin}"
                                Opacity="{Binding ToastOpacity}">
                            <Border.Transitions>
                                <Transitions>
                                    <ThicknessTransition Property="Margin" Duration="0:0:0.24" />
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                                </Transitions>
                            </Border.Transitions>
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Foreground="White"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap" />
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="10"
                                      IsVisible="{Binding IsProgressVisible}">
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Height="6"
                                                 Value="{Binding Progress}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="#D5E2F0"
                                               Text="{Binding ProgressText}" />
                                    <Button Grid.Column="2"
                                            Classes="toastAction"
                                            Command="{Binding CancelTransferCommand}"
                                            Content="{Binding CancelText}"
                                            IsVisible="{Binding IsCancelable}" />
                                </Grid>
                                <Button Grid.Row="2"
                                        Classes="toastAction"
                                        HorizontalAlignment="Right"
                                        Command="{Binding CancelTransferCommand}"
                                        Content="{Binding CancelText}"
                                        IsVisible="{Binding IsActionVisible}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</Window>
