<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PureSFTP.Views.ChoiceDialogWindow"
        Width="420"
        Height="230"
        MinWidth="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#EEF3F8">
    <Window.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#102236" />
        </Style>

        <Style Selector="TextBlock.message">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#5E7388" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#102236" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#102236" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#102236" />
            <Setter Property="BorderBrush" Value="#CAD6E2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Styles>

    <Border Margin="16"
            Padding="18"
            Background="#FCFDFE"
            BorderBrush="#D7E1EB"
            BorderThickness="1"
            CornerRadius="10">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <TextBlock Name="TitleTextBlock"
                       Classes="title"
                       TextWrapping="Wrap" />
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock Name="MessageTextBlock"
                           Classes="message"
                           TextWrapping="Wrap" />
            </ScrollViewer>
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                <Button Name="CancelButton"
                        Classes="secondary"
                        Click="OnCancelClick" />
                <Button Name="SecondaryButton"
                        Classes="secondary"
                        Click="OnSecondaryClick" />
                <Button Name="PrimaryButton"
                        Classes="primary"
                        Click="OnPrimaryClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
